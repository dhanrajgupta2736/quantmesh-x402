# Orchestrator Environment Variables
# Copy this file to .env and fill in your values

PORT=4000
ALGORAND_NETWORK=testnet
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=

# Wallet address receiving micropayments (58-character Algorand address)
ROUTER_WALLET_ADDRESS=YOUR_58_CHARACTER_ALGORAND_ADDRESS_HERE

# Worker agent payout addresses (future use)
WORKER_A_ADDRESS=YOUR_SENTIMENT_WORKER_ADDRESS
WORKER_B_ADDRESS=YOUR_ONCHAIN_WORKER_ADDRESS
WORKER_C_ADDRESS=YOUR_TA_WORKER_ADDRESS
WORKER_D_ADDRESS=YOUR_FUSION_WORKER_ADDRESS

# Worker Endpoints
WORKER_A_URL=http://localhost:5001/agent/sentiment
WORKER_B_URL=http://localhost:5002/agent/onchain
WORKER_C_URL=http://localhost:5003/agent/ta
WORKER_D_URL=http://localhost:5001/agent/fusion

# Algorand ASA Configuration
USDC_TESTNET_ASA_ID=10458941

# x402 Facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz
