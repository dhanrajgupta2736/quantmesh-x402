# Orchestrator Environment Variables
# Copy this file to .env and fill in your values

PORT=4000
ALGORAND_NETWORK=testnet
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=

# Wallet address receiving micropayments (58-character Algorand address)
ROUTER_ADDRESS=YOUR_58_CHARACTER_ALGORAND_ADDRESS_HERE

# REQUIRED FOR ATOMIC WORKER PAYOUT — without this, workerPayoutStatus will be 'skipped'
# ROUTER_MNEMONIC=your twenty five word algorand mnemonic phrase here

# Worker agent payout addresses
WORKER_A_PAYOUT_ADDR=YOUR_SENTIMENT_WORKER_ADDRESS
WORKER_B_PAYOUT_ADDR=YOUR_ONCHAIN_WORKER_ADDRESS
WORKER_C_PAYOUT_ADDR=YOUR_TA_WORKER_ADDRESS
WORKER_D_PAYOUT_ADDR=YOUR_FUSION_WORKER_ADDRESS

# Worker Endpoints
WORKER_A_URL=http://localhost:5001/agent/sentiment
WORKER_B_URL=http://localhost:5002/agent/onchain
WORKER_C_URL=http://localhost:5002/agent/ta
WORKER_D_URL=http://localhost:5001/agent/fusion

# Algorand ASA Configuration
USDC_TESTNET_ASA_ID=10458941

# x402 Facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz
