{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuantMeshOrchestrationContract",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "tokenSymbol": { "type": "string", "example": "ALGO" }
      },
      "required": ["tokenSymbol"]
    },
    "response": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "example": "success" },
        "clientPaymentTxId": { "type": "string", "example": "ALGORAND_CLIENT_PAYMENT_TX_ID_HERE" },
        "totalCostUsdc": { "type": "string", "example": "0.0070" },
        "dynamicSplit": {
          "type": "object",
          "properties": {
            "amountA": { "type": "number", "example": 2021 },
            "amountB": { "type": "number", "example": 1979 },
            "amountC": { "type": "number", "example": 1000 },
            "amountD": { "type": "number", "example": 1000 },
            "weights": {
              "type": "object",
              "properties": {
                "sentiment": { "type": "number", "example": 0.35 },
                "onchain": { "type": "number", "example": 0.34 },
                "ta": { "type": "number", "example": 0.31 }
              }
            }
          }
        },
        "signalFusion": {
          "type": "object",
          "properties": {
            "compositeScore": { "type": "number", "example": 82 },
            "verdict": { "type": "string", "example": "STRONG BUY" },
            "confidencePct": { "type": "number", "example": 88 }
          }
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "sentimentScore": { "type": "number", "example": 78 },
            "onChainWhaleFlow": { "type": "string", "example": "+18% Net Inflow" },
            "technicalIndicator": { "type": "string", "example": "RSI 58 - Bullish Crossover" }
          }
        },
        "onChainReceipt": {
          "type": "object",
          "properties": {
            "explorerUrl": { "type": "string", "example": "https://lora.algokit.io/testnet/transaction/..." },
            "workerPayoutGroupTxId": { "type": ["string", "null"], "example": "ALGORAND_ATOMIC_GROUP_TX_ID_HERE" },
            "attestationHash": { "type": "string", "example": "a3f9b2c4..." }
          }
        }
      },
      "required": ["status", "clientPaymentTxId", "signalFusion", "breakdown", "onChainReceipt"]
    }
  }
}
